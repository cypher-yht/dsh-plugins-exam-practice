{
  "name": "@local/exam-practice",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "在 DSH Web UI 新增「四六级刷题」面板：导入题库、在线练习、交卷自动判分并回顾错题。",
  "exports": {
    ".": "./index.js",
