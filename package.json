    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "bank/*.json",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cet4",
    "cet6",
    "exam",
    "practice",
    "question-bank"
  ],
  "author": "cypher-yht",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cypher-yht/dsh-plugins-exam-practice.git"
  },
  "homepage": "https://github.com/cypher-yht/dsh-plugins-exam-practice#readme",
  "bugs": {
    "url": "https://github.com/cypher-yht/dsh-plugins-exam-practice/issues"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
